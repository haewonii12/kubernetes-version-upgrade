# backend/.env 로 복사해서 사용하세요 (cp .env.example backend/.env).
# 모든 값은 UPGRADE_AGENT_ 접두사가 붙은 환경변수로도 override 가능합니다.

# 실제 클러스터 분석(mock_mode=false) 시 기동할 kubectl-ai MCP 서버 명령.
# kubectl-ai v0.0.29 이하는 --mcp-server 모드에서 내장 kubectl/bash tool이
# 등록되지 않는 버그가 있습니다 (v0.0.31에서 수정). `kubectl-ai version`으로
# 반드시 0.0.31 이상인지 확인하세요. PATH의 시스템 바이너리를 바꿀 수 없다면
# 아래처럼 별도 경로의 최신 바이너리를 직접 가리키면 됩니다.
UPGRADE_AGENT_MCP_SERVER_COMMAND=kubectl-ai
# UPGRADE_AGENT_MCP_SERVER_COMMAND=/home/<user>/.local/kubectl-ai-v0.0.31/kubectl-ai
UPGRADE_AGENT_MCP_SERVER_ARGS=--mcp-server

# Deprecated API 교차검증용 pluto 바이너리 (Docker 이미지에 구워져 있음).
# 없으면 pluto 스캔만 조용히 건너뛰고 RAG 판정은 그대로 동작한다.
# UPGRADE_AGENT_PLUTO_COMMAND=pluto

# RAG 문서 경로 (기본값: <repo>/rag/documents)
# UPGRADE_AGENT_RAG_DOCUMENTS_DIR=/app/rag/documents

# kubeconfig 업로드 임시 저장 경로 (분석 종료 후 자동 삭제됨)
UPGRADE_AGENT_KUBECONFIG_TMP_DIR=/tmp/k8s-upgrade-agent/kubeconfig

# 프론트엔드 Origin (CORS)
UPGRADE_AGENT_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Autonomous Agent (agi 브랜치 전용, /api/v1/agent/* — 개방망 전제) ---
# 기본값은 모두 비활성/미설정이며, 설정하지 않아도 나머지 Tool은 정상 동작하고
# 이 Tool들만 "not_configured"로 조용히 fallback한다.
# UPGRADE_AGENT_AGENT_OPEN_NETWORK_ENABLED=true
# UPGRADE_AGENT_AGENT_WEB_SEARCH_API_KEY=
# UPGRADE_AGENT_AGENT_GITHUB_TOKEN=
# UPGRADE_AGENT_AGENT_MAX_ITERATIONS=6
# UPGRADE_AGENT_AGENT_MAX_TOOL_CALLS=30
