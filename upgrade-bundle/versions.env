# 1.32 → 1.36 순차 업그레이드 번들의 단일 버전 소스.
# 값은 2026-08 기준 각 minor의 최신 patch (dl.k8s.io/release/stable-1.XX.txt).
# 대상: RHEL 8 / x86_64 / containerd / stacked etcd (kubeadm).
#
# 재확인:  bash fetch.sh --resolve   (최신 patch로 이 파일을 다시 씀)

# 업그레이드 경로 (현재 → 목표). minor를 건너뛰지 않는다.
UPGRADE_PATH="1.33 1.34 1.35 1.36"
RPM_ARCH="x86_64"
IMAGE_PLATFORM="linux/amd64"

# minor별 kube* 패키지 patch 버전
K8S_1_33="1.33.13"
K8S_1_34="1.34.11"
K8S_1_35="1.35.8"
K8S_1_36="1.36.4"

# minor별 의존 패키지 (pkgs.k8s.io/core:/stable:/v1.XX/rpm 저장소에 담긴 버전)
CRITOOLS_1_33="1.33.0"; CNI_1_33="1.6.0"
CRITOOLS_1_34="1.34.0"; CNI_1_34="1.7.1"
CRITOOLS_1_35="1.35.0"; CNI_1_35="1.8.0"
CRITOOLS_1_36="1.36.0"; CNI_1_36="1.9.1"

# minor별 kubeadm 기본 컨테이너 이미지 (`kubeadm config images list` 결과)
#   kube-apiserver/-controller-manager/-scheduler/-proxy 태그는 K8S_1_XX와 동일
COREDNS_1_33="v1.12.0"; PAUSE_1_33="3.10";   ETCD_1_33="3.5.24-0"
COREDNS_1_34="v1.12.1"; PAUSE_1_34="3.10.1"; ETCD_1_34="3.6.5-0"
COREDNS_1_35="v1.13.1"; PAUSE_1_35="3.10.1"; ETCD_1_35="3.6.6-0"
COREDNS_1_36="v1.14.2"; PAUSE_1_36="3.10.2"; ETCD_1_36="3.6.8-0"

REGISTRY="registry.k8s.io"
RPM_REPO_BASE="https://pkgs.k8s.io/core:/stable:/v%s/rpm"
